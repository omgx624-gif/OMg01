# ---------------------------------------------------------------------------
# ตัวอย่างตัวแปรสภาพแวดล้อม (คัดลอกเป็น .env แล้วกรอกค่าจริง)
# ---------------------------------------------------------------------------
# ในโหมดพัฒนาทั่วไป (ต้องไม่ใช้กับ Production)
DJANGO_SECRET_KEY=your-long-random-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE=0

# ---------------------------------------------------------------------------
# ล็อกอินด้วย Google (OAuth 2.0) — อ่านรายละเอียดการตั้งได้ใน README
# ---------------------------------------------------------------------------
# ไปที่ https://console.cloud.google.com -> Credentials -> OAuth client ID
#   - ประเภท: Web application
#   - URI ที่อนุญาต:
#       http://localhost:8000/accounts/google/login/callback/
#   - ใช้คำสั่งต่อไปนี้สร้างปุ่ม + SocialApp ในฐานข้อมูล:
#       python manage.py create_google_app
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# ตัวเลือกขั้นสูง (ปล่อยว่าง/ไม่ตั้งค่าก็ได้)
# ---------------------------------------------------------------------------
# Production ต้องขึ้นต้นด้วย https:// ตามโดเมนจริง เช่น https://example.com
# CORS_ALLOWED_ORIGINS=https://example.com

# Cache backend (ค่า default เป็นหน่วยความจำในเครื่อง)
# DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# DJANGO_CACHE_LOCATION=restaurant-cache

# อีเมล — default ส่งลง terminal (console) เหมาะกับ Development
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=noreply@restaurant.local

# LINE Notify Token สำหรับแจ้งเตือนออเดอร์/จองโต๊ะ/รีวิว (เว้นว่าง = ปิด)
# LINE_NOTIFY_TOKEN=